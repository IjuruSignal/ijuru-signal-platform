# Application defaults: local SQLite; copy to .env.local (never commit real secrets).
NODE_ENV=development
DB_PROVIDER=sqlite
SQLITE_PATH=./data/app.sqlite
# Set to postgres to switch only after running PostgreSQL migrations and importing data.
DATABASE_URL=postgresql://ijuru_signal:CHANGE_ME@127.0.0.1:55432/ijuru_signal
# No external AI requests unless explicitly configured.
AI_PROVIDER=disabled
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1200
# Comma-separated explicit allowed provider hosts; enforce this on the server.
AI_ALLOWED_HOSTS=
