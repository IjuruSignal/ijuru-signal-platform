# Application defaults: local SQLite; copy to .env.local (never commit real secrets).
NODE_ENV=development
DB_PROVIDER=sqlite
SQLITE_PATH=./data/app.sqlite
# Set to postgres to switch only after running PostgreSQL migrations and importing data.
DATABASE_URL=postgresql://ijuru_signal:CHANGE_ME@127.0.0.1:55432/ijuru_signal
# AI Configuration:
# Quick setup: Setting OPENROUTER_API_KEY (or AI_API_KEY without AI_PROVIDER) works out of the box with zero extra config:
# OPENROUTER_API_KEY=sk-or-v1-...
# AI_MODEL defaults to google/gemini-2.5-flash and baseUrl to https://openrouter.ai/api
#
# Custom / Strict Provider Setup:
# Set AI_PROVIDER to 'openai-compatible' or 'anthropic' to enforce explicit model, key, and host allowlist.
AI_PROVIDER=disabled
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
OPENROUTER_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1200
# Comma-separated explicit allowed provider hosts; enforce this on the server.
AI_ALLOWED_HOSTS=
